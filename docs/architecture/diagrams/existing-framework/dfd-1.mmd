%% title: DFD level 1
%% alt: DFD level 1, six tabs with separate display-only anatomy and background surface state
flowchart TB
  tps["Treatment planning system"]
  physicist["Medical physicist"]
  printer["Printer or CAD"]

  p1(("1 Import"))
  p2(("2 Cylinder"))
  p3(("3 Channels"))
  p4(("4 Tandem"))
  p5(("5 Export"))
  d1[("Plan and settings")]
  d2[("Shapes")]

  tps -->|"DICOM folder"| p1
  physicist -->|"config JSON"| p1
  p1 -->|"needles, Central Axis, structures, probe frame, settings"| d1
  physicist -->|"size and collar"| p2
  d1 --> p2
  p2 -->|"cylinder solid"| d2
  physicist -->|"bore, dead space"| p3
  d1 --> p3
  p3 -->|"needle solids"| d2
  physicist -->|"curve or STEP"| p4
  p3 -->|"tandem channel"| p4
  p2 -->|"length and diameter"| p4
  p4 -->|"tandem solid"| d2
  d2 --> p5
  d1 -->|"patient and plan"| p5
  p5 -->|"STL or STEP"| printer
  p5 -->|"PDF and JSON"| physicist

  p6(("6 Structures preview"))
  worker(("Surface reconstruction<br/>single worker"))
  anatomy[("Anatomy state<br/>visibility, pending, generation,<br/>errors, opacity, cached meshes")]
  d1 -->|"immutable patient contours and probe frame"| p6
  physicist -->|"show or hide ROI, mode, selected-ROI opacity, highlight, colour"| p6
  p2 -->|"current cylinder length"| p6
  p6 <-->|"aligned meshes or wires, status and opacity"| anatomy
  p6 -->|"nonselectable surface or outline preview; visible loading or failure reason"| physicist
  p1 -->|"new import clears state and invalidates old results"| anatomy
  anatomy -->|"Surface/Both request"| worker
  worker -->|"generation-tagged mesh or error, queued result"| anatomy
