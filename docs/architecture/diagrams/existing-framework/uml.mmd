%% title: UML
%% alt: UML of RadiotherapyApp, the models MainWindow creates, the signals between them and back to MainWindow, and ShapeModel
classDiagram
  class RadiotherapyApp {
    signals
    values
  }
  class MainWindow
  class NavigationModel {
    views index 0 to 5
  }
  class DisplayModel {
    shapes by label
  }
  class OrbitCameraViewer3d
  class DicomModel
  class CylinderModel
  class ChannelsModel
  class TandemModel
  class ShapeModel {
    label
    TopoDS_Shape
    ShapeTypes
  }

  RadiotherapyApp --> MainWindow
  RadiotherapyApp --> AppSignals
  RadiotherapyApp --> Values
  MainWindow --> NavigationModel
  MainWindow --> OrbitCameraViewer3d
  MainWindow --> DisplayModel
  DisplayModel ..> OrbitCameraViewer3d : shapes_changed
  MainWindow --> DicomModel
  MainWindow --> CylinderModel
  MainWindow --> ChannelsModel
  MainWindow --> TandemModel
  DicomModel ..> CylinderModel : values_changed
  DicomModel ..> ChannelsModel : values_changed
  CylinderModel ..> TandemModel : values_changed
  CylinderModel ..> MainWindow : values_changed
  ChannelsModel ..> TandemModel : tandem_changed
  CylinderModel --> ShapeModel
  ChannelsModel --> ShapeModel
  TandemModel --> ShapeModel
  DisplayModel o-- ShapeModel

  class StructuresModel {
    mode = Surface
    visible and pending ROI sets
    generation and patient mesh cache
    changed()
    opacity_changed(roi, opacity)
    highlight_changed()
    color_changed(roi, rgb)
  }
  class SurfaceTask {
    run()
    reconstruct()
  }
  class SurfaceSignals {
    finished(SurfaceResult)
  }
  MainWindow --> StructuresModel
  DicomModel ..> StructuresModel : values_changed via MainWindow
  CylinderModel ..> StructuresModel : current length via MainWindow
  DisplayModel ..> StructuresModel : reset_completed
  StructuresView --> StructuresModel : set_visible, set_highlight, set_mode, set_opacity, set_color
  StructuresModel ..> StructuresView : changed
  StructuresModel ..> OrbitCameraViewer3d : changed, surface and outline refresh
  StructuresModel ..> OrbitCameraViewer3d : opacity_changed, update existing actors
  StructuresModel ..> OrbitCameraViewer3d : highlight_changed, recolour existing actors
  StructuresModel ..> OrbitCameraViewer3d : color_changed, recolour existing actors
  StructuresModel ..> StructuresView : opacity_changed, selected ROI slider
  StructuresModel ..> StructuresView : color_changed, list swatch
  StructuresModel --> SurfaceTask : QThreadPool, one worker
  SurfaceTask --> SurfaceSignals
  SurfaceSignals ..> StructuresModel : finished, queued to GUI thread
  SurfaceTask --> AnatomySurface : reconstruct or reuse patient mesh
  StructuresModel o-- AnatomySurface : cache by ROI
  note for StructuresModel "Surface is the default, without automatic outline fallback.<br/>Opacity changes reuse per-ROI actors; anatomy never enters exports."
