%% title: System architecture
%% alt: System architecture of brachify, a layered desktop application with a presentation layer, application state, domain services, third party libraries and local storage
flowchart TB
  ext["<b>External</b><br/>In: DICOM folder, config JSON, tandem STEP file, user settings<br/>Out: STL, STEP, PDF sheet, config JSON"]
  pres["<b>Presentation layer, PySide6</b><br/>MainWindow with nav buttons and dialogs<br/>Six views: Import, Cylinder, Channels, Tandem, Export, Structures<br/>Structures controls: Surface / Outlines / Both, selected-ROI opacity, row highlight, and Change colour<br/>OrbitCameraViewer3d: AIS_Triangulation surfaces and AIS_Shape outlines"]
  state["<b>Application state, QObject models</b><br/>RadiotherapyApp with signals and values<br/>DicomModel, CylinderModel, ChannelsModel, TandemModel<br/>NavigationModel, DisplayModel, ShapeModel, StructuresModel<br/>SurfaceTask on a single QThreadPool worker; pending ROIs, generation and mesh cache<br/>Surface is the default; per-ROI opacity is separate from geometry changes"]
  domain["<b>Domain services</b><br/>dicom: fileio, data, structures, load_structures, structure_list<br/>mesh: cylinder, channel, tandem, notch, helper, intersections, fileio, structure_contours, structure_surfaces<br/>pdf: template_reference, canvas<br/>settings: defaults, load, values, reset, needle_templates, cylinder_templates"]
  lib["<b>Libraries</b><br/>PySide6, pydicom, pythonocc-core with OpenCASCADE, reportlab, matplotlib, numpy<br/>scipy and scikit-image loaded inside the surface worker"]
  disk[("<b>Local storage, ~/brachify</b><br/>app.log, filepaths.json, needle_templates.json, cylinder_templates.json")]

  ext -->|"inputs"| pres
  pres -->|"outputs"| ext
  pres -->|"user actions, app signals"| state
  state -->|"shapes_changed and anatomy changed rebuild presentations; opacity_changed, highlight_changed and color_changed update actors"| pres
  state -->|"calls; surface reconstruction off the GUI thread"| domain
  domain -->|"uses"| lib
  domain -->|"reads and writes"| disk
