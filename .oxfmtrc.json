{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "**/anti-slop/**",
    "**/*.md",
    "**/*.json",
    "**/*.yml",
    "**/node_modules/**",
    "**/build/**",
    "**/dist/**",
    "**/coverage/**",
    "**/htmlcov/**",
    "**/.venv/**",
    "**/venv/**",
    "**/_build/**",
    ".vs/**"
  ]
}
